@inherits LayoutComponentBase
@using VeterinaryClinicBlazor.Services
@inject LanguageState LanguageState

<div class="page">
    <header class="topbar">
        <a href="/" class="brand">
            @(LanguageState.SelectedLanguage == "da"
                ? "Dyreklinik Database"
                : "Veterinary Clinic Database")
        </a>

        <select class="language-select" @bind="LanguageState.SelectedLanguage">
            <option value="en">English</option>
            <option value="da">Dansk</option>
        </select>
    </header>

    <main class="content">
        @Body
    </main>
</div>